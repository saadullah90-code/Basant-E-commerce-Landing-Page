{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=23075 BASE_PATH=/ pnpm --filter @workspace/basant-landing run build",
  "outputDirectory": "artifacts/basant-landing/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
